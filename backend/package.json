    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "prisma": "^6.5.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
