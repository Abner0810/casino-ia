{
  "name": "casino-api",
  "version": "1.0.0",
  "description": "API del simulador de casino online (Plinko + Blackjack)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "build": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "test:logic": "node --test \"tests/*.test.js\"",
    "test:unit": "node --test \"tests/*.test.js\"",
    "test:e2e": "node --test tests/backend.e2e.mjs",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "check": "node scripts/check.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "test:integration": "node --test tests/integration/backend.integration.mjs",
    "test:smoke": "node tests/smoke.http.mjs",
    "verify": "node scripts/verify.mjs",
    "contract:generate": "node scripts/generate-openapi.mjs",
    "docker:setup": "node scripts/setup-docker.mjs",
    "docker:up": "docker compose up --build -d --wait",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build -d --wait",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api migrate",
    "docker:test": "docker compose -f compose.test.yaml --profile runner run --build --rm tests"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "prisma": "^6.5.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
