# Referencia para backend/.env; npm run docker:setup genera secretos aleatorios.
# El usuario y DB deben ser identificadores simples; contraseña URL-safe (hex).
POSTGRES_USER=casino
POSTGRES_DB=casino
POSTGRES_PASSWORD=REEMPLAZAR_CON_HEX_ALEATORIO
JWT_ACCESS_SECRET=REEMPLAZAR_CON_SECRETO_ALEATORIO_MINIMO_32_CARACTERES
JWT_REFRESH_SECRET=REEMPLAZAR_CON_OTRO_SECRETO_ALEATORIO_MINIMO_32_CARACTERES
CORS_ORIGINS=http://localhost:5173
API_PORT=3000
