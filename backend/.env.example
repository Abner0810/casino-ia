# Copia este archivo como .env y completa tus valores reales

# Base de datos (Render te da ambas URLs al crear la instancia PostgreSQL 18)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# JWT - usa strings aleatorios de al menos 32 caracteres (ej: openssl rand -hex 32)
JWT_ACCESS_SECRET="cambia-este-secret-de-access-token-min-32-caracteres"
JWT_REFRESH_SECRET="cambia-este-secret-de-refresh-token-min-32-caracteres"

# CORS - dominio de Firebase Hosting (coma-separado si hay varios)
CORS_ORIGINS="https://tu-proyecto.web.app"

# Servidor
PORT=3000
NODE_ENV=development
